# SHOP client — copy to client/.env and adjust as needed.

# Backend API base URL
VITE_API_URL=http://localhost:5000

# Paystack — PUBLIC key only (safe to expose to the browser)
# SECURITY: NEVER put PAYSTACK_SECRET_KEY here. Public key only.
# Get your live public key from https://dashboard.paystack.com/#/settings/developer
VITE_PAYSTACK_PUBLIC_KEY=your_paystack_public_key_here
