# SHOP Server — copy to .env and fill in values. Never commit .env.

PORT=5000
NODE_ENV=development
MONGODB_URI=
CLIENT_URL=http://localhost:5173
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Cloudinary — ALL media storage (product images + payment receipts)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email notifications (Gmail SMTP — use an App Password, not your Gmail password)
# 1. Enable 2FA on secondkiro0@gmail.com
# 2. Go to Google Account → Security → App Passwords → generate one
# 3. Paste the 16-character app password into EMAIL_PASS below
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=secondkiro0@gmail.com
EMAIL_PASS=
ADMIN_EMAIL=secondkiro0@gmail.com

# File limits
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,application/pdf
UPLOAD_DIR=uploads

# Initial superadmin (created once on first boot)
ADMIN_INITIAL_EMAIL=secondkiro0@gmail.com
ADMIN_INITIAL_PASSWORD=ChangeMe123!
ADMIN_INITIAL_NAME=Shop Admin
