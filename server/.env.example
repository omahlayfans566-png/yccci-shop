# SHOP Server — copy to .env and fill in values. Never commit .env.

PORT=5000
NODE_ENV=development
MONGODB_URI=
CLIENT_URL=http://localhost:5173
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Cloudinary — ALL media storage (product images + payment receipts)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Paystack — LIVE payment gateway
# SECURITY: NEVER expose PAYSTACK_SECRET_KEY to frontend code or commit to git.
# Get your live keys from https://dashboard.paystack.com/#/settings/developer
PAYSTACK_SECRET_KEY=your_paystack_secret_key_here

# Email notifications (Gmail SMTP — use an App Password, not your Gmail password)
# 1. Enable 2FA on your Gmail account
# 2. Go to Google Account → Security → App Passwords → generate one
# 3. Paste the 16-character app password below
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
ADMIN_EMAIL=

# File limits
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,application/pdf
UPLOAD_DIR=uploads

# Initial superadmin (created once on first boot)
ADMIN_INITIAL_EMAIL=admin@yourdomain.com
ADMIN_INITIAL_PASSWORD=ChangeMe123!
ADMIN_INITIAL_NAME=Shop Admin
