# ──────────────────────────────────────────────────────────
# SHOP SERVER — Environment variables
# Copy this file to .env and fill in real values.
# NEVER commit the real .env to version control.
# ──────────────────────────────────────────────────────────

# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/shop?appName=Cluster0

# Frontend origin(s) – comma-separated for multiple
CLIENT_URL=http://localhost:5173

# JWT — use a long random secret in production (min 32 chars)
JWT_SECRET=change-me-to-a-long-random-secret-string-in-production
JWT_EXPIRES_IN=7d

# Backblaze B2 credentials (S3-compatible API)
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=yccci-shop
B2_ENDPOINT=s3.us-east-005.backblazeb2.com

# File upload limits
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,application/pdf

# Local upload directory (fallback when B2 is not configured)
UPLOAD_DIR=uploads

# Initial superadmin account — created once on first boot
ADMIN_INITIAL_EMAIL=admin@shop.com
ADMIN_INITIAL_PASSWORD=ChangeMe123!
ADMIN_INITIAL_NAME=Shop Admin
