# SHOP — Root environment variables example
# See server/.env.example for the full server variable list.
# Never commit real .env files.

# Server
PORT=5000
NODE_ENV=production
MONGODB_URI=
CLIENT_URL=https://shop.yourdomain.com
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Cloudinary (ALL media — product images + payment receipts)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# File limits
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,application/pdf

# Initial admin (created once on first boot)
ADMIN_INITIAL_EMAIL=admin@shop.com
ADMIN_INITIAL_PASSWORD=ChangeMe123!
ADMIN_INITIAL_NAME=Shop Admin

# Client
VITE_API_URL=https://your-api.onrender.com
