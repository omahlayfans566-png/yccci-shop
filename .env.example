# Root-level env example — see server/.env.example for full variable list
# This file documents the structure only. Never commit real secrets.

# Server
PORT=5000
NODE_ENV=production
MONGODB_URI=
CLIENT_URL=https://shop.yourdomain.com
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Backblaze B2
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=yccci-shop
B2_ENDPOINT=s3.us-east-005.backblazeb2.com

# File limits
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp,application/pdf

# Initial admin (created once on first boot — change password immediately)
ADMIN_INITIAL_EMAIL=admin@shop.com
ADMIN_INITIAL_PASSWORD=ChangeMe123!
ADMIN_INITIAL_NAME=Shop Admin

# Client
VITE_API_URL=https://your-api.onrender.com
